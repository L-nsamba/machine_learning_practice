      "source": [
        "import numpy as np"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Soft max function\n",
        "def softmax(z):\n",
        "  return np.exp(z) / np.sum(np.exp(z))\n",
        "\n",
        "answer = softmax(np.array([1.3,5.1,2.2,0.7,1.1]))\n",
        "\n",
        "print(answer.round(2))\n"
      ],
